{
  "name": "@local/official-writing",
  "version": "1.7.0",
  "license": "MIT",
  "description": "DeepSeek Harness 机关公文写作与方正排版插件，提供起草规范、素材管理与严格排版 Word 导出功能。",
  "private": true,
  "type": "module",
  "author": "Skystmyr",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "official-writing",
    "word-formatting",
    "python-docx"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./formatter/*": "./formatter/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "formatter/*.py",
    "formatter/*.ps1",
    "formatter/SKILL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  }
}

